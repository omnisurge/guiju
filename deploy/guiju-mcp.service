[Unit]
Description=guiju MCP service (native currency)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guiju
Group=guiju
WorkingDirectory=/opt/guiju
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GUIJU_HOME=/var/lib/guiju
Environment=GUIJU_CURRENCY=native
Environment=GUIJU_CURRENCY_CACHE=/var/lib/guiju/currency-cache
# HTTP Host/Origin allowlist：Caddy 反代会保留公网 Host，必须显式放行，
# 否则 DNS rebinding 防线会把线上请求全部拒绝（403）。punycode 与 Unicode 都写，
# 兼容浏览器实际发送的 ASCII Host 与服务端配置检查。
Environment=GUIJU_MCP_ALLOWED_HOSTS=guiju.守夜人.中国,guiju.xn--gmqx6we1b.xn--fiqs8s
Environment=GUIJU_MCP_ALLOWED_ORIGINS=https://guiju.守夜人.中国,https://guiju.xn--gmqx6we1b.xn--fiqs8s
ExecStart=/usr/bin/python3 -m guiju mcp --http --host 127.0.0.1 --port 18083 --path /mcp
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/guiju
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
